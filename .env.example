# ── SBI Animal Bite Center — environment variables ──────────────────────────
# All variables are OPTIONAL: without DATABASE_URL the site runs in static
# mode on its built-in catalogue (frontend-only deploy).

# Postgres / Neon connection string (enables live data when set)
# Local example:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Neon example:   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/app_db?sslmode=require
#DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin panel passkey (default: 5309 — change for production)
#ADMIN_PASSKEY=5309

# Where uploaded media is stored (default: public/uploads/)
#UPLOAD_DIR=public/uploads
